# Copy to .env for local dev (this file lives in backend/, where uvicorn/alembic run from).
# On Railway these come from managed add-on env vars instead.
DATABASE_URL=postgresql+psycopg://ariha:ariha_dev_pw@localhost:5433/ariha_dev
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=dev-only-change-me
COOKIE_SECURE=false
# STORAGE_BACKEND=local is dev-only — get_storage() refuses to start it when ENV=production.
# Swap to an S3-compatible backend (e.g. Cloudflare R2) before deploying; see TECHNICAL_DECISIONS.md §7.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/uploads
# --- Production: set STORAGE_BACKEND=s3 and fill these in (Cloudflare R2 example) ---
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=ariha-documents
# STORAGE_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_REGION=auto
# CV auto-extraction (candidates) — get a free-tier key at aistudio.google.com/apikey.
# This sends CV content (name, contact info, ...) to Google's API — a real cross-border
# data transfer, same CNDP-authorization caveat as the AI Assistant strategy in
# TECHNICAL_DECISIONS.md §5. Dev/test only until that's resolved; leave blank to disable
# (the extract-cv endpoint returns a clean 503 instead of failing to start).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
